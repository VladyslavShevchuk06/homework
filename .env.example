# Supabase Postgres connection string (Project → Settings → Database → Connection string)
DATABASE_URL=""

# Random string, min 32 characters (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Base URL of the auth server
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL exposed to the client
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GrowthBook (A/B testing) — optional; unset disables experiments
NEXT_PUBLIC_GROWTHBOOK_API_HOST="https://cdn.growthbook.io"
NEXT_PUBLIC_GROWTHBOOK_CLIENT_KEY=""

# Mixpanel (exposure tracking) — optional; unset disables tracking
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""